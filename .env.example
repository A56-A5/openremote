# --- worker / CLI ---------------------------------------------------------
# Supabase project (Settings -> API). The installer writes these into
# ~/.config/openremote/config.json via `openremote config --url --key`.
OPENREMOTE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
OPENREMOTE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Where the web app is deployed (printed by `openremote code`).
# OPENREMOTE_WEB_URL=https://openremote-link.vercel.app

# Optional: pin the OpenCode server URL (worker probes common ports and
# spawns `opencode serve` itself otherwise).
# OPENCODE_SERVER_URL=http://localhost:4096

# --- web build (web/.env for `vite build`, or Vercel project env) ---------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- test tunables (test/worker-smoke.mjs shortens these) -----------------
# OPENREMOTE_TICK_MS=1000
# OPENREMOTE_FILE_FLUSH_MS=8000
# OPENREMOTE_CLAIM_IDLE_MS=15000
# OPENREMOTE_CLAIM_POLL_MS=5000
# OPENREMOTE_PERM_POLL_MS=10000
# OPENREMOTE_HEARTBEAT_MS=60000
# OPENREMOTE_SWEEP_MS=3600000
# OPENREMOTE_AUTH_REFRESH_MS=1800000
